# Copy to .env.local (git-ignored, Next.js loads it automatically) and fill
# in. Only this .env.example is committed.

# Base URL of the codebase-rag dashboard API (src/codebase_rag/api.py, run
# via `codebase-rag-api` / `uvicorn codebase_rag.api:app`). Defaults to
# http://localhost:8000 for local dev if unset; point this at the deployed
# host once the API ships to the NAS (T11).
NEXT_PUBLIC_API_URL=http://localhost:8000
