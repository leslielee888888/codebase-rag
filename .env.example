# Copy to .env and fill in. .env is git-ignored and must never be committed —
# only this .env.example is.

# Release to run. Bumping this and re-pulling is the whole update (see
# docker-compose.yml). Unset/blank uses `latest`.
IMAGE_TAG=v0.1.0

# LAN port the dashboard's web service publishes (T11). Only `web` is
# exposed — `api` stays internal to the compose network. Default 3000;
# override if that's already taken on this host.
WEB_PORT=3000

# Claude credential for the generation call (FR-2, §10 Q5) — subscription
# OAuth, not a pay-as-you-go API key, per standing preference. Run
# `claude setup-token` on a machine logged into Claude Code and paste the
# sk-ant-oat01-... token here.
#
# This goes through the Claude Agent SDK, not the raw Messages API (see
# generation.py's module docstring) — the SDK's subprocess picks this up
# from the environment on its own; nothing in the app passes it explicitly.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-XXXXXXXXXXXXXXXXXXXXXX
